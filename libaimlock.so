// aimlock.cpp
#include <jni.h>
#include <pthread.h>
#include <unistd.h>
#include <dlfcn.h>
#include <math.h>
#include <string.h>
#include <sys/time.h>
#include "dobby.h"

typedef void*(*F0)();
typedef void**(*F1)(void*,unsigned long*);
typedef void*(*F2)(void*);
typedef void*(*F3)(void*,const char*,const char*);
typedef void*(*F4)(void*,const char*,int);
typedef void*(*F5)(void*,const char*);
typedef int(*F6)(void*);
typedef void*(*F7)(void*,void*,void**,void**);
typedef void*(*F8)(void*);

static F0 f0; static F1 f1; static F2 f2;
static F3 f3; static F4 f4; static F5 f5;
static F6 f6; static F7 f7; static F8 f8;

static void *kA, *kB, *kC, *kD, *kE;
static int pA=-1, pB=-1, pC=-1, pD=-1, pE=-1;
static void *mA, *mB, *mC, *mD;

static void *me=0, *cam=0;
static int tm=-1;
static volatile float tx=0, ty=0;
static volatile int td=0;

static int jt(void) {
    struct timeval v; gettimeofday(&v, 0);
    unsigned s = v.tv_usec ^ (v.tv_sec * 2654435761u);
    s ^= s << 13; s ^= s >> 17; s ^= s << 5;
    return 7500 + (s % 2500);
}
static long long lw = 0;
static int wgate(void) {
    struct timeval v; gettimeofday(&v, 0);
    long long n = (long long)v.tv_sec*1000000LL + v.tv_usec;
    if (n - lw < 16000) return 0;
    lw = n; return 1;
}
static float nz(void) {
    struct timeval v; gettimeofday(&v, 0);
    unsigned s = v.tv_usec * 1103515245u + 12345u;
    s ^= s >> 11;
    if ((s & 0xFF) < 8) return ((float)(s % 41) - 20.0f) * 0.6f;
    return ((float)(s % 3) - 1.0f) * 0.15f;
}
static long long bt = 0;
static int wu(void) {
    struct timeval v; gettimeofday(&v, 0);
    long long n = (long long)v.tv_sec*1000000LL + v.tv_usec;
    if (bt == 0) { bt = n; return 1; }
    return (n - bt) < 3000000LL;
}
static int ic = 0;
static void ils(int f) {
    if (f) ic = 0; else ic++;
    if (ic > 240) usleep(50000);
}

struct V3 { float x, y, z; };
struct RY { V3 a; V3 b; };

static void* lc(const char* ns, const char* nm) {
    unsigned long n = 0;
    void** a = f1(f0(), &n);
    if (!a) return 0;
    for (unsigned long i = 0; i < n; i++) {
        void* im = f2(a[i]);
        if (!im) continue;
        void* c = f3(im, ns, nm);
        if (c) return c;
    }
    return 0;
}
static void* i0(void* m, void* o) {
    if (!m) return 0; void* e = 0; return f7(m, o, 0, &e);
}
static void* i1(void* m, void* o, void* a) {
    if (!m) return 0; void* r[1] = { a }; void* e = 0;
    return f7(m, o, r, &e);
}
static void rv3(void* b, float& x, float& y, float& z) {
    if (!b) { x=y=z=0; return; }
    float* p = (float*)((char*)b + 16);
    x = p[0]; y = p[1]; z = p[2];
}
static __thread float _v[3];
static void* mv3(float x, float y, float z) {
    _v[0]=x; _v[1]=y; _v[2]=z; return _v;
}

static int gh(void* pl, float& hx, float& hy, float& hz) {
    if (pE >= 0 && mD) {
        void* an = *(void**)((char*)pl + pE);
        if (an) {
            void* hd = i1(mD, an, (void*)(long)10);
            if (hd) {
                void* pp = i0(mA, hd);
                if (pp) { rv3(pp, hx, hy, hz); return 1; }
            }
        }
    }
    void* tr = *(void**)((char*)pl + pA);
    if (!tr) return 0;
    void* pp = i0(mA, tr);
    if (!pp) return 0;
    rv3(pp, hx, hy, hz);
    hy += 1.61f;
    return 1;
}

static void sd(void) {
    td = 0;
    if (!me || !cam) return;
    void* fi = f5(kB, "instance");
    if (!fi) return;
    int o = f6(fi);
    void* mg = *(void**)((char*)kB + o);
    if (!mg) return;
    void* ls = *(void**)((char*)mg + pD);
    if (!ls) return;
    void* it = *(void**)((char*)ls + 0x10);
    int cn = *(int*)((char*)ls + 0x18);
    if (!it || cn <= 0) return;

    void* cp = i0(mA, cam);
    float cx, cy, cz; rv3(cp, cx, cy, cz);

    float bd = 280.0f, bx = 0, by = 0;
    int fd = 0;
    void** ar = (void**)((char*)it + 0x10);

    for (int i = 0; i < cn; i++) {
        void* pl = ar[i];
        if (!pl || pl == me) continue;
        if (*(int*)((char*)pl + pB) == tm) continue;
        float hx, hy, hz;
        if (!gh(pl, hx, hy, hz)) continue;
        float dx = hx-cx, dy = hy-cy, dz = hz-cz;
        float d = sqrtf(dx*dx + dy*dy + dz*dz);
        if (d < 1.5f || d > 220.0f) continue;
        void* sb = i1(mB, cam, mv3(hx, hy, hz));
        float sx, sy, sz2; rv3(sb, sx, sy, sz2);
        if (sz2 < 0) continue;
        float sdx = sx - 360.0f;
        float sdy = sy - 800.0f;
        float sd2 = sqrtf(sdx*sdx + sdy*sdy);
        if (sd2 < bd) { bd = sd2; bx = sx; by = sy; fd = 1; }
    }
    if (fd) { tx = bx; ty = by; td = 1; }
    ils(fd);
}

typedef RY (*sprT)(void*, V3);
static sprT real = 0;

static RY hk(void* c, V3 p) {
    if (c == cam && td && !wu()) {
        V3 r; r.x = tx + nz(); r.y = ty + nz(); r.z = 0;
        return real(c, r);
    }
    return real(c, p);
}

static void* wk(void*) {
    f8(f0());
    usleep(2500000);
    while (1) {
        if (!kA) {
            kA = lc("", "PlayerEntity");
            kB = lc("", "PlayerManager");
            kC = lc("UnityEngine", "Transform");
            kD = lc("UnityEngine", "Camera");
            kE = lc("UnityEngine", "Animator");
            if (kA && kB && kC && kD) {
                pA = f6(f5(kA, "m_Transform"));
                pB = f6(f5(kA, "team"));
                pC = f6(f5(kA, "aimPivot"));
                pE = f6(f5(kA, "animator"));
                pD = f6(f5(kB, "allPlayers"));
                mA = f4(kC, "get_position", 0);
                mB = f4(kD, "WorldToScreenPoint", 1);
                mC = f4(kD, "get_main", 0);
                if (kE) mD = f4(kE, "GetBoneTransform", 1);
            }
        }
        if (kD && !real) {
            void* sp = f4(kD, "ScreenPointToRay", 1);
            if (sp) {
                void* nat = *(void**)sp;
                if (nat) DobbyHook(nat, (void*)hk, (void**)&real);
            }
        }
        if (kB && pD >= 0) {
            void* f = f5(kB, "instance");
            if (f) {
                int o = f6(f);
                void* mg = *(void**)((char*)kB + o);
                if (mg) {
                    void* ls = *(void**)((char*)mg + pD);
                    if (ls) {
                        void* it = *(void**)((char*)ls + 0x10);
                        int cn = *(int*)((char*)ls + 0x18);
                        if (it && cn > 0) {
                            void** ar = (void**)((char*)it + 0x10);
                            void* nm = ar[0];
                            if (nm && nm != me) {
                                me = nm;
                                tm = *(int*)((char*)me + pB);
                                void* m = f4(kD, "get_main", 0);
                                cam = i0(m, kD);
                                bt = 0;
                            } else if (!nm) { me = 0; cam = 0; }
                        }
                    }
                }
            }
        }
        if (me && cam && wgate()) sd();
        usleep(jt());
    }
    return 0;
}

static int bind_api(void) {
    void* h = dlopen("libil2cpp.so", RTLD_NOW);
    if (!h) return 0;
    f0 = (F0)dlsym(h, "il2cpp_domain_get");
    f1 = (F1)dlsym(h, "il2cpp_domain_get_assemblies");
    f2 = (F2)dlsym(h, "il2cpp_assembly_get_image");
    f3 = (F3)dlsym(h, "il2cpp_class_from_name");
    f4 = (F4)dlsym(h, "il2cpp_class_get_method_from_name");
    f5 = (F5)dlsym(h, "il2cpp_class_get_field_from_name");
    f6 = (F6)dlsym(h, "il2cpp_field_get_offset");
    f7 = (F7)dlsym(h, "il2cpp_runtime_invoke");
    f8 = (F8)dlsym(h, "il2cpp_thread_attach");
    return f0 && f1 && f3 && f4 && f5 && f6 && f7;
}

__attribute__((constructor))
static void boot(void) {
    pthread_t t;
    pthread_create(&t, 0, [](void*) -> void* {
        for (int i = 0; i < 120; i++) {
            if (bind_api()) return wk(0);
            usleep(500000);
        }
        return (void*)0;
    }, 0);
}
JNIEXPORT jint JNI_OnLoad(JavaVM*, void*) { return JNI_VERSION_1_6; }
